{
    "name": "mage-os/module-advanced-report",
    "description": "Advanced sales and catalog reporting for Magento Open Source / Mage-OS.",
    "type": "magento2-module",
    "license": [
        "MIT"
    ],
    "authors": [
        {
            "name": "Luca Fuser",
            "email": "fuse94@libero.it"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "magento/composer-dependency-version-audit-plugin": true,
            "magento/magento-composer-installer": false
        }
    },
    "require": {
        "php": "~8.3.0||~8.4.0||~8.5.0",
        "magento/framework": "*",
        "magento/module-store": "*",
        "magento/module-sales": "*",
        "magento/module-catalog": "*",
        "magento/module-catalog-inventory": "*",
        "magento/module-customer": "*",
        "magento/module-quote": "*",
        "magento/module-backend": "*",
        "magento/module-reports": "*",
        "magento/module-user": "*",
        "magento/module-eav": "*",
        "magento/module-directory": "*",
        "magento/module-payment": "*",
        "magento/module-shipping": "*",
        "magento/module-ui": "*",
        "magento/module-config": "*"
    },
    "suggest": {
        "magento/module-checkout": "Provides the checkout/cart/delete_quote_after setting read by the cart reports; the default is used when it is not installed.",
        "magento/module-inventory-api": "Used to read multi-source stock levels for the catalog_stock dataset and, with the modules below, to enable the catalog_salable dataset.",
        "magento/module-inventory-catalog": "Required by the catalog_salable dataset.",
        "magento/module-inventory-indexer": "Required by the catalog_salable dataset.",
        "magento/module-inventory-reservations": "Required by the catalog_salable dataset."
    },
    "require-dev": {
        "bitexpert/phpstan-magento": "^0.44",
        "friendsofphp/php-cs-fixer": "^3.95",
        "magento/magento-coding-standard": "^41",
        "phpmd/phpmd": "^3@dev",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^13.3",
        "rector/rector": "^2.6"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "MageOS\\AdvancedReport\\": ""
        }
    },
    "repositories": {
        "mage-os-mirror": {
            "type": "composer",
            "url": "https://mirror.mage-os.org/"
        },
        "mage-os": {
            "type": "composer",
            "url": "https://repo.mage-os.org/"
        }
    },
    "scripts": {
        "test:unit": "phpunit -c phpunit.xml.dist --testsuite unit",
        "test:phpstan": "phpstan analyse --memory-limit=1G",
        "test:cs-fixer": "php-cs-fixer fix --dry-run --diff --allow-risky=yes",
        "test:xml": "php dev/validate-xml.php",
        "test:rector": "rector process --dry-run",
        "test:phpmd": "phpmd analyze --format=text --ruleset=phpmd.xml Api Console Controller Model Observer Test ViewModel",
        "test": [
            "@test:unit",
            "@test:phpstan",
            "@test:cs-fixer",
            "@test:rector",
            "@test:phpmd",
            "@test:xml"
        ]
    }
}
